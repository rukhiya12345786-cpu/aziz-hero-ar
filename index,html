<!doctype html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aziz Hero AR App</title>
<style>
* { box-sizing: border-box; }
body {
margin: 0; background: #111420; color: #fff;
font: 16px system-ui, sans-serif;
}
main { max-width: 760px; margin: auto; padding: 18px; }
p { color: #bcc5dc; line-height: 1.5; }
#stage {
position: relative; aspect-ratio: 4/3;
background: #050609; border-radius: 18px; overflow: hidden;
}
video, canvas {
position: absolute; inset: 0; width: 100%; height: 100%;
}
.mirror { transform: scaleX(-1); }
.controls {
display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0;
}
button, select, .file {
padding: 12px; border-radius: 10px;
border: 1px solid #536080; background: #303958;
color: white; font: inherit; cursor: pointer;
}
button:disabled { opacity: .45; }
.btn-record { background: #d93838; border-color: #ff5e5e; }
.btn-record.recording { background: #ff0000; animation: pulse 1s infinite; }
@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
.file input { display: none; }
.adjust { display: block; margin: 14px 0; }
#status { padding: 12px; background: #222b43; border-radius: 10px; }
</style>
<script type="importmap">
{
"imports": {
"three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
"three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
}
}
</script>
</head>
<body>
<main>
<h1>Aziz Hero AR App</h1>
<p>Face AR Tracking & Voice Recording (Supports GLB, OBJ, FBX)</p>

<div id="stage">
<video id="video" class="mirror" autoplay muted playsinline></video>
<canvas id="canvas" class="mirror"></canvas>
</div>

<div class="controls">
<button id="start" disabled>Camera Start</button>
<button id="switchCam" disabled>Switch Camera</button>
<button id="record" class="btn-record" disabled>Start Recording</button>
<button id="stop" disabled>Camera Stop</button>
<label class="file">
3D Import (.glb, .fbx, .obj)
<input id="import" type="file" accept=".glb,.fbx,.obj">
</label>
<select id="character" aria-label="Character">
<option value="demo">Demo robot</option>
</select>
</div>

<label class="adjust">
Head size
<input id="size" type="range" min="0.6" max="2.4" step="0.05" value="1.25">
</label>
<label class="adjust">
Offset
<input id="offset" type="range" min="-0.6" max="0.6" step="0.02" value="0">
</label>
<label class="adjust">
<input id="flip" type="checkbox"> Model 180° Flip
</label>

<p id="status" role="status">Libraries loading...</p>
</main>

<script type="module">
import * as THREE from "three";
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
import { OBJLoader } from "three/addons/loaders/OBJLoader.js";
import { FBXLoader } from "three/addons/loaders/FBXLoader.js";

const $ = id => document.getElementById(id);
const message = text => $("status").textContent = text;
const normalize = name => name.toLowerCase().replace(/[^a-z0-9]/g, "");
const video = $("video");
const canvas = $("canvas");

let currentFacingMode = "user";
let mediaRecorder = null;
let recordedChunks = [];
let isRecording = false;
let audioStream = null;

const renderer = new THREE.WebGLRenderer({
canvas: canvas, alpha: true, antialias: true, preserveDrawingBuffer: true
});
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

const scene = new THREE.Scene();
const camera = new THREE.OrthographicCamera(-320, 320, 240, -240, 0.1, 3000);
camera.position.z = 1000;

scene.add(new THREE.HemisphereLight(0xffffff, 0x566a99, 2.5));
const light = new THREE.DirectionalLight(0xffffff, 3);
light.position.set(0, 3, 5);
scene.add(light);

const anchor = new THREE.Group();
const content = new THREE.Group();
anchor.add(content);
anchor.visible = false;
scene.add(anchor);

function ball(parent, color, position, scale) {
const mesh = new THREE.Mesh(
new THREE.SphereGeometry(1, 24, 16),
new THREE.MeshStandardMaterial({ color })
);
mesh.position.set(...position);
mesh.scale.set(...scale);
parent.add(mesh);
return mesh;
}

const demo = new THREE.Group();
ball(demo, 0x9980ff, [0, 0, 0], [.5, .62, .42]);
const eyeL = ball(demo, 0xffffff, [-.19, .14, .36], [.11, .12, .06]);
const eyeR = ball(demo, 0xffffff, [.19, .14, .36], [.11, .12, .06]);
for (const eye of [eyeL, eyeR]) {
ball(eye, 0x18223d, [0, 0, .7], [.5, .65, .5]);
}
ball(demo, 0xffbd82, [0, -.03, .43], [.07, .08, .08]);
const mouth = ball(demo, 0x261a45, [0, -.28, .37], [.16, .035, .05]);
content.add(demo);

let imported = null;
let selected = "demo";
let tracker = null;
let stream = null;
let running = false;
let starting = false;
let generation = 0;
let animation = 0;
let lastVideoTime = -1;

const matrix = new THREE.Matrix4();
const position = new THREE.Vector3();
const quaternion = new THREE.Quaternion();
const scale = new THREE.Vector3();

const manager = new THREE.LoadingManager();
const gltfLoader = new GLTFLoader(manager);
const objLoader = new OBJLoader(manager);
const fbxLoader = new FBXLoader(manager);

function chooseCharacter() {
selected = $("character").value;
content.clear();
content.add(selected === "demo" ? demo : imported.root);
}
$("character").onchange = chooseCharacter;

function dispose(root) {
root.traverse(object => {
object.geometry?.dispose();
const materials = Array.isArray(object.material) ? object.material : [object.material];
for (const material of materials) {
if (!material) continue;
for (const value of Object.values(material)) {
if (value?.isTexture) value.dispose();
}
material.dispose();
}
});
}

$("import").onchange = async event => {
const input = event.target;
const file = input.files[0];
input.value = "";
if (!file) return;
input.disabled = true;
let candidate;

try {
if (file.size > 50 * 1024 * 1024) throw Error("Max file size 50 MB");

const ext = file.name.split('.').pop().toLowerCase();
const url = URL.createObjectURL(file);

if (ext === "glb") {
const gltf = await gltfLoader.loadAsync(url);
candidate = gltf.scene;
} else if (ext === "obj") {
candidate = await objLoader.loadAsync(url);
} else if (ext === "fbx") {
candidate = await fbxLoader.loadAsync(url);
} else {
throw Error("Unsupported format. Use .glb, .fbx, or .obj");
}
URL.revokeObjectURL(url);

candidate.updateMatrixWorld(true);

const box = new THREE.Box3().setFromObject(candidate);
const dimensions = box.getSize(new THREE.Vector3());
const center = box.getCenter(new THREE.Vector3());

if (!Number.isFinite(dimensions.x) || dimensions.x <= 0) {
throw Error("Invalid 3D geometry");
}

const root = new THREE.Group();
root.add(candidate);
candidate.position.sub(center);
root.scale.setScalar(1 / dimensions.x);

const morphs = [];
candidate.traverse(object => {
if (!object.morphTargetDictionary || !object.morphTargetInfluences) return;
for (const [name, index] of Object.entries(object.morphTargetDictionary)) {
morphs.push({ object, index, key: normalize(name) });
}
});

content.clear();
if (imported) dispose(imported.root);

imported = { root, morphs, name: file.name };

let option = $("character").querySelector('[value="custom"]');
if (!option) {
option = new Option(file.name, "custom");
$("character").add(option);
}
option.textContent = file.name;
$("character").value = "custom";
chooseCharacter();

message(`Successfully imported: ${file.name}`);
} catch (error) {
if (candidate && candidate !== imported?.root.children[0]) dispose(candidate);
message("Import failed: " + error.message);
} finally {
input.disabled = false;
}
};

function fitCamera() {
const w = video.videoWidth, h = video.videoHeight;
camera.left = -w / 2;
camera.right = w / 2;
camera.top = h / 2;
camera.bottom = -h / 2;
camera.updateProjectionMatrix();
renderer.setSize(w, h, false);
$("stage").style.aspectRatio = `${w}/${h}`;
}

function updateFace(result) {
const face = result.faceLandmarks?.[0];
anchor.visible = Boolean(face);
if (!face) return;

const w = video.videoWidth, h = video.videoHeight;
const width = Math.hypot((face[454].x - face[234].x) * w, (face[454].y - face[234].y) * h);

anchor.position.set(
(face[1].x - .5) * w,
(.5 - face[1].y) * h + Number($("offset").value) * width,
0
);
anchor.scale.setScalar(width * Number($("size").value));

const pose = result.facialTransformationMatrixes?.[0]?.data;
if (pose?.length === 16) {
matrix.fromArray(pose);
matrix.decompose(position, quaternion, scale);
anchor.quaternion.copy(quaternion);
}
content.rotation.y = $("flip").checked ? Math.PI : 0;

const values = {};
for (const category of result.faceBlendshapes?.[0]?.categories || []) {
values[normalize(category.categoryName)] = Math.max(0, Math.min(1, category.score));
}

if (selected === "demo") {
eyeL.scale.y = .12 * Math.max(.05, 1 - (values.eyeblinkleft || 0));
eyeR.scale.y = .12 * Math.max(.05, 1 - (values.eyeblinkright || 0));
mouth.scale.y = .035 + .18 * (values.jawopen || 0);
mouth.scale.x = .16 + .06 * Math.max(values.mouthsmileleft || 0, values.mouthsmileright || 0);
} else {
for (const { object, index, key } of imported.morphs) {
if (Object.hasOwn(values, key)) {
object.morphTargetInfluences[index] = values[key];
}
}
}
}

function stopCamera() {
if(isRecording) stopRecording();
generation++;
running = false;
cancelAnimationFrame(animation);
stream?.getTracks().forEach(track => track.stop());
audioStream?.getTracks().forEach(track => track.stop());
stream = null;
audioStream = null;
video.srcObject = null;
anchor.visible = false;
renderer.clear();
$("start").disabled = starting;
$("stop").disabled = true;
$("switchCam").disabled = true;
$("record").disabled = true;
}

function frame() {
if (!running) return;
try {
if (video.readyState >= 2 && video.currentTime !== lastVideoTime) {
lastVideoTime = video.currentTime;
updateFace(tracker.detectForVideo(video, performance.now()));
}
renderer.render(scene, camera);
animation = requestAnimationFrame(frame);
} catch (error) {
stopCamera();
message("Tracking stopped: " + error.message);
}
}

