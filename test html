
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Azeez AR Studio - Head Tracking Test</title>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js"
  }
}
</script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #080d18;
  color: white;
  font-family: Arial, sans-serif;
  overflow: hidden;
}

#stage {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: #080d18;
}

#camera {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #080d18;
}

#threeCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

#topPanel {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  z-index: 5;
  padding: 14px;
  background: rgba(5, 12, 25, 0.82);
  border: 1px solid #34445d;
  border-radius: 14px;
}

h2 {
  margin: 0 0 10px;
  font-size: 18px;
}

#status {
  font-size: 13px;
  color: #80ffb0;
  margin-bottom: 12px;
  line-height: 1.5;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

button {
  background: #1767d2;
  border: 0;
  color: white;
  border-radius: 8px;
  padding: 11px 13px;
  font-weight: bold;
  font-size: 12px;
}

button:disabled {
  opacity: 0.5;
}

#bottomInfo {
  position: absolute;
  bottom: 15px;
  left: 12px;
  right: 12px;
  z-index: 5;
  padding: 12px;
  border-radius: 10px;
  background: rgba(5, 12, 25, 0.8);
  font-size: 12px;
  line-height: 1.6;
}

.hidden {
  display: none;
}
</style>
</head>

<body>

<div id="stage">
  <video id="camera" autoplay playsinline muted></video>
  <canvas id="threeCanvas"></canvas>
</div>

<div id="topPanel">
  <h2>AZEEZ AR STUDIO</h2>

  <div id="status">Ready. Start camera.</div>

  <div class="controls">
    <button id="startButton">START CAMERA</button>
    <button id="switchButton">SWITCH CAMERA</button>
    <button id="trackingButton">TRACKING ON</button>
    <button id="headButton">DUMMY HEAD ON</button>
  </div>
</div>

<div id="bottomInfo">
  Move your head left, right, up and down.<br>
  The 3D dummy head should follow your face.
</div>

<script type="module">

import * as THREE from "three";

const video = document.getElementById("camera");
const canvas = document.getElementById("threeCanvas");
const statusBox = document.getElementById("status");

const startButton = document.getElementById("startButton");
const switchButton = document.getElementById("switchButton");
const trackingButton = document.getElementById("trackingButton");
const headButton = document.getElementById("headButton");

let stream = null;
let faceLandmarker = null;

let cameraFacing = "user";
let trackingEnabled = true;
let headVisible = true;
let cameraStarted = false;

let lastVideoTime = -1;

function setStatus(message) {
  statusBox.textContent = message;
}

// THREE.JS SCENE

const scene = new THREE.Scene();

const camera3D = new THREE.OrthographicCamera(
  0, window.innerWidth,
  0, window.innerHeight,
  0.1, 2000
);

camera3D.position.z = 1000;

const renderer = new THREE.WebGLRenderer({
  canvas: canvas,
  alpha: true,
  antialias: true
});

renderer.setPixelRatio(
  Math.min(window.devicePixelRatio || 1, 2)
);

renderer.setSize(
  window.innerWidth,
  window.innerHeight
);

renderer.setClearColor(0x000000, 0);

// LIGHTS

scene.add(new THREE.AmbientLight(0xffffff, 2));

const light = new THREE.DirectionalLight(0xffffff, 3);
light.position.set(-200, -300, 800);
scene.add(light);

// DUMMY HEAD GROUP

const headGroup = new THREE.Group();
scene.add(headGroup);

// Head shape

const headMaterial = new THREE.MeshStandardMaterial({
  color: 0xd7a17e,
  roughness: 0.72
});

const headGeometry = new THREE.SphereGeometry(1, 48, 48);

const headMesh = new THREE.Mesh(
  headGeometry,
  headMaterial
);

headMesh.scale.set(0.78, 1.0, 0.68);
headGroup.add(headMesh);

// Ears

const earGeometry = new THREE.SphereGeometry(0.22, 24, 24);

const earMaterial = new THREE.MeshStandardMaterial({
  color: 0xc68e70
});

function createEar(x) {
  const ear = new THREE.Mesh(earGeometry, earMaterial);
  ear.position.set(x, 0.02, 0);
  ear.scale.set(0.55, 1.0, 0.45);
  headGroup.add(ear);
}

createEar(-0.78);
createEar(0.78);

// Eyes

const eyeGeometry = new THREE.SphereGeometry(0.105, 24, 24);

const eyeMaterial = new THREE.MeshStandardMaterial({
  color: 0x20212b,
  roughness: 0.3
});

function createEye(x) {
  const eye = new THREE.Mesh(eyeGeometry, eyeMaterial);
  eye.position.set(x, 0.18, 0.62);
  eye.scale.set(1.0, 0.65, 0.45);
  headGroup.add(eye);
}

createEye(-0.29);
createEye(0.29);

// Nose

const noseGeometry = new THREE.ConeGeometry(0.13, 0.38, 24);

const noseMaterial = new THREE.MeshStandardMaterial({
  color: 0xc68e70
});

const nose = new THREE.Mesh(noseGeometry, noseMaterial);
nose.position.set(0, -0.03, 0.73);
nose.rotation.x = Math.PI / 2;
headGroup.add(nose);

// Mouth

const mouth = new THREE.Mesh(
  new THREE.SphereGeometry(0.16, 24, 12),
  new THREE.MeshStandardMaterial({ color: 0x743d3d })
);

mouth.position.set(0, -0.43, 0.58);
mouth.scale.set(1.0, 0.18, 0.25);
headGroup.add(mouth);

// Initially hide until face detected

headGroup.visible = false;

// RESIZE

function resizeScene() {
  const width = window.innerWidth;
  const height = window.innerHeight;

  renderer.setSize(width, height);

  camera3D.left = 0;
  camera3D.right = width;
  camera3D.top = 0;
  camera3D.bottom = height;

  camera3D.updateProjectionMatrix();
}

window.addEventListener("resize", resizeScene);
window.addEventListener("orientationchange", () => {
  setTimeout(resizeScene, 300);
});

// CAMERA DISPLAY

function updateMirror() {
  const transform = cameraFacing === "user"
    ? "scaleX(-1)"
    : "none";

  video.style.transform = transform;
  canvas.style.transform = transform;
}

// CAMERA START

async function startCamera() {
  try {
    if (stream) {
      stream.getTracks().forEach(track => track.stop());
      stream = null;
    }

    video.srcObject = null;

    stream = await navigator.mediaDevices.getUserMedia({
      audio: false,
      video: {
        facingMode: cameraFacing,
        width: { ideal: 1280 },
        height: { ideal: 720 }
      }
    });

    video.srcObject = stream;

    await video.play();

    cameraStarted = true;
    updateMirror();

    setStatus("Camera running. Loading face tracking...");

    await initializeFaceTracking();

  } catch (error) {
    console.error(error);
    setStatus("Camera error: " + error.message);
  }
}

// MEDIAPIPE FACE TRACKING

async function initializeFaceTracking() {
  try {
    if (faceLandmarker) {
      setStatus("Face tracking ready.");
      return;
    }

    const vision = await import(
      "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs"
    );

    const fileset = await vision.FilesetResolver.forVisionTasks(
      "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
    );

    faceLandmarker = await vision.FaceLandmarker.createFromOptions(
      fileset,
      {
        baseOptions: {
          modelAssetPath:
            "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",
          delegate: "GPU"
        },

        runningMode: "VIDEO",
        numFaces: 1,
        outputFaceBlendshapes: false,
        outputFacialTransformationMatrixes: true
      }
    );

    setStatus("Face tracking ready. Looking for face...");

  } catch (error) {
    console.error("Face tracking error:", error);
    setStatus("Tracking load error: " + error.message);
  }
}

// VIDEO COVER COORDINATES

function getVideoCoordinates(point) {
  const width = window.innerWidth;
  const height = window.innerHeight;

  const videoWidth = video.videoWidth || width;
  const videoHeight = video.videoHeight || height;

  const scale = Math.max(
    width / videoWidth,
    height / videoHeight
  );

  const renderedWidth = videoWidth * scale;
  const renderedHeight = videoHeight * scale;

  const offsetX = (width - renderedWidth) / 2;
  const offsetY = (height - renderedHeight) / 2;

  return {
    x: point.x * renderedWidth + offsetX,
    y: point.y * renderedHeight + offsetY
  };
}

// FACE TRACKING UPDATE

function updateHead(landmarks) {
  if (!landmarks || !landmarks.length) {
    headGroup.visible = false;
    setStatus("Camera running. No face detected.");
    return;
  }

  if (!trackingEnabled) {
    setStatus("Face detected. Tracking paused.");
    return;
  }

  const nosePoint = landmarks[1];
  const leftEye = landmarks[33];
  const rightEye = landmarks[263];
  const forehead = landmarks[10];
  const chin = landmarks[152];

  const nosePosition = getVideoCoordinates(nosePoint);
  const leftPosition = getVideoCoordinates(leftEye);
  const rightPosition = getVideoCoordinates(rightEye);

  const eyeDistance = Math.hypot(
    rightPosition.x - leftPosition.x,
    rightPosition.y - leftPosition.y
  );

  const eyeCenterX = (leftPosition.x + rightPosition.x) / 2;
  const eyeCenterY = (leftPosition.y + rightPosition.y) / 2;

  // Approximate head rotation from facial landmarks

  const yawAmount =
    (nosePosition.x - eyeCenterX) /
    Math.max(eyeDistance, 1);

  const pitchAmount =
    (nosePosition.y - eyeCenterY) /
    Math.max(eyeDistance, 1);

  const rollAmount = Math.atan2(
    rightPosition.y - leftPosition.y,
    rightPosition.x - leftPosition.x
  );

  // Position

  headGroup.position.x = nosePosition.x;
  headGroup.position.y = nosePosition.y;

  // Size follows face distance

  const headScale = Math.max(
    20,
    Math.min(eyeDistance * 2.5, 500)
  );

  headGroup.scale.set(
    headScale,
    headScale,
    headScale
  );

  // Approximate rotation

  headGroup.rotation.y = THREE.MathUtils.clamp(
    yawAmount * 1.8,
    -0.9,
    0.9
  );

  headGroup.rotation.x = THREE.MathUtils.clamp(
    pitchAmount * 1.2,
    -0.7,
    0.7
  );

  headGroup.rotation.z = -rollAmount;

  headGroup.visible = headVisible;

  setStatus("FACE DETECTED | Tracking active");
}

// TRACKING LOOP

function trackingLoop() {
  requestAnimationFrame(trackingLoop);

  if (
    cameraStarted &&
    faceLandmarker &&
    video.readyState >= 2 &&
    video.currentTime !== lastVideoTime
  ) {
    lastVideoTime = video.currentTime;

    try {
      const result = faceLandmarker.detectForVideo(
        video,
        performance.now()
      );

      if (
        result.faceLandmarks &&
        result.faceLandmarks.length > 0
      ) {
        updateHead(result.faceLandmarks[0]);
      } else {
        headGroup.visible = false;
        setStatus("Camera running. Looking for face...");
      }

    } catch (error) {
      console.error("Tracking frame error:", error);
    }
  }

  renderer.render(scene, camera3D);
}

// BUTTONS

startButton.addEventListener("click", async () => {
  await startCamera();
});

switchButton.addEventListener("click", async () => {
  cameraFacing = cameraFacing === "user"
    ? "environment"
    : "user";

  await startCamera();
});

trackingButton.addEventListener("click", () => {
  trackingEnabled = !trackingEnabled;

  trackingButton.textContent = trackingEnabled
    ? "TRACKING ON"
    : "TRACKING OFF";

  if (!trackingEnabled) {
    headGroup.visible = false;
    setStatus("Tracking paused.");
  } else {
    setStatus("Tracking enabled. Looking for face...");
  }
});

headButton.addEventListener("click", () => {
  headVisible = !headVisible;

  headButton.textContent = headVisible
    ? "DUMMY HEAD ON"
    : "DUMMY HEAD OFF";

  headGroup.visible = headVisible && trackingEnabled;
});

// INITIALIZE

resizeScene();
trackingLoop();

</script>
</body>
</html>
